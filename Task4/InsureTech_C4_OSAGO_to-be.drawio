        <mxCell id="t422" value="&lt;b&gt;core-db&lt;/b&gt;&lt;br/&gt;PG + outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="110" height="70" as="geometry" /></mxCell>
