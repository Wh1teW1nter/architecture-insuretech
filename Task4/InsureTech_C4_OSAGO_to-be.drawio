        <mxCell id="t47" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br/&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;fontColor=#ffffff;strokeColor=#073B6F;fontFamily=Arial;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="110" height="55" as="geometry" /></mxCell>
        <mxCell id="t48" value="&lt;b&gt;Партнёры B2B&lt;/b&gt;&lt;br/&gt;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;fontFamily=Arial;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="120" height="55" as="geometry" /></mxCell>
        <mxCell id="t49" value="&lt;b&gt;Платёжный сервис&lt;/b&gt;&lt;br/&gt;[Software System]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;fontFamily=Arial;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="120" height="55" as="geometry" /></mxCell>
        <mxCell id="t410" value="&lt;b&gt;СК (ОСАГО API)&lt;/b&gt;&lt;br/&gt;[Software System] ×10&lt;br/&gt;POST заявка / GET предложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;strokeColor=#6B6B6B;fontFamily=Arial;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="t411" value="InsureTech Prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 8;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="180" y="50" width="980" height="820" as="geometry" /></mxCell>
        <mxCell id="t412" value="&lt;b&gt;InsureTech Web&lt;/b&gt;&lt;br/&gt;[React]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Заявка ОСАГО + live-лента предложений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="80" width="170" height="85" as="geometry" /></mxCell>
        <mxCell id="t413" value="&lt;b&gt;core-app&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot ×N]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Оформление ОСАГО (заявка, выбор оффера, полис).&lt;br/&gt;REST + SSE для UI.&lt;br/&gt;Outbox: osago.quote.requested / policies.issued&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="200" height="130" as="geometry" /></mxCell>
        <mxCell id="t414" value="&lt;b&gt;client-info&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot ×N]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Клиентские данные&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="140" height="75" as="geometry" /></mxCell>
        <mxCell id="t415" value="&lt;b&gt;Redis Pub/Sub&lt;/b&gt;&lt;br/&gt;[Managed Redis]&lt;br/&gt;&lt;font style="font-size:9px"&gt;fan-out офферов на pod&lt;br/&gt;с активным SSE (multi-instance)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;fontSize=10;align=center;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="220" y="370" width="180" height="75" as="geometry" /></mxCell>
        <mxCell id="t416" value="&lt;b&gt;Event Streaming&lt;/b&gt;&lt;br/&gt;[Managed Apache Kafka]&lt;br/&gt;&lt;font style="font-size:9px"&gt;products.* / tariffs.* / policies.issued&lt;br/&gt;&lt;b&gt;osago.quote.requested&lt;/b&gt;&lt;br/&gt;&lt;b&gt;osago.offer.received&lt;/b&gt;&lt;br/&gt;&lt;b&gt;osago.quote.completed|timeout&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#C77D0A;fontFamily=Arial;fontSize=10;align=center;verticalAlign=top;spacingTop=4;fontStyle=1" vertex="1" parent="1"><mxGeometry x="460" y="240" width="210" height="130" as="geometry" /></mxCell>
        <mxCell id="t417" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;&lt;br/&gt;[Kotlin ×N]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Продукты/тарифы → events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="t418" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br/&gt;[Kotlin, Spring Boot ×N]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Создание заявок во все СК.&lt;br/&gt;Polling GET предложения ≤60с.&lt;br/&gt;Публикует офферы по мере готовности.&lt;br/&gt;Своё хранилище: ДА&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="200" height="140" as="geometry" /></mxCell>
        <mxCell id="t419" value="&lt;b&gt;ins-comp-settlement&lt;/b&gt;&lt;br/&gt;[Kotlin ×N]&lt;br/&gt;&lt;font style="font-size:9px"&gt;Взаиморасчёты; consume policies/products&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=11;align=center;verticalAlign=top;spacingTop=4;spacingLeft=4;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="180" height="90" as="geometry" /></mxCell>
        <mxCell id="t420" value="&lt;b&gt;Outbox Relay&lt;/b&gt;&lt;br/&gt;core-app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="470" width="120" height="45" as="geometry" /></mxCell>
        <mxCell id="t421" value="&lt;b&gt;Outbox Relay&lt;/b&gt;&lt;br/&gt;osago-aggregator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="140" height="45" as="geometry" /></mxCell>
        <mxCell id="t422" value="&lt;b&gt;core-db&lt;/b&gt;&lt;br/&gt;PG + outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="110" height="70" as="geometry" /></mxCell>
        <mxCell id="t423" value="&lt;b&gt;client-info-db&lt;/b&gt;&lt;br/&gt;PG" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="160" width="110" height="60" as="geometry" /></mxCell>
        <mxCell id="t424" value="&lt;b&gt;osago-db&lt;/b&gt;&lt;br/&gt;PostgreSQL&lt;br/&gt;quoteId, SK app ids,&lt;br/&gt;poll state, deadline" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="130" height="90" as="geometry" /></mxCell>
        <mxCell id="t425" value="&lt;b&gt;settlement-db&lt;/b&gt;&lt;br/&gt;PG" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="540" width="110" height="70" as="geometry" /></mxCell>
        <mxCell id="t426" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br/&gt;• Хранилище: &lt;b&gt;ДА&lt;/b&gt; (osago-db) — состояние заявки/опроса общее для всех реплик.&lt;br/&gt;• API к core-app: &lt;b&gt;Event Streaming&lt;/b&gt; (не sync REST): consume &lt;i&gt;osago.quote.requested&lt;/i&gt;; publish &lt;i&gt;osago.offer.received&lt;/i&gt; / completed|timeout.&lt;br/&gt;• Подход как у products: async опрос СК, push результатов." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="t427" value="&lt;b&gt;Web ↔ core-app&lt;/b&gt;&lt;br/&gt;1) &lt;b&gt;REST&lt;/b&gt; POST /api/osago/applications — создать заявку → 202 + id.&lt;br/&gt;2) &lt;b&gt;SSE&lt;/b&gt; GET /api/osago/applications/{id}/stream — офферы на UI сразу по мере прихода (≤60с).&lt;br/&gt;Оформление полиса — REST (выбор оффера / оплата)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="170" height="160" as="geometry" /></mxCell>
        <mxCell id="t428" value="&lt;b&gt;Multi-instance&lt;/b&gt;&lt;br/&gt;Kafka consumer group + partition key=quoteId.&lt;br/&gt;Состояние опроса — в osago-db (любая реплика продолжает).&lt;br/&gt;SSE: core-app подписывается на Redis канал quoteId; потребитель Kafka публикует оффер в Redis → нужный pod пушит в SSE." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="t429" value="&lt;b&gt;Нагрузка ~2500 concurrent&lt;/b&gt;&lt;br/&gt;HPA на core-app / osago-aggregator.&lt;br/&gt;RL на входе и на исходящих вызовах к каждой СК." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="t430" value="RL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Arial;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="175" width="36" height="20" as="geometry" /></mxCell>
        <mxCell id="t431" value="TO 60s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Arial;fontSize=9;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="175" width="50" height="20" as="geometry" /></mxCell>
