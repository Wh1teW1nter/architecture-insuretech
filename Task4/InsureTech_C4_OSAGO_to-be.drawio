        <mxCell id="t424" value="&lt;b&gt;osago-db&lt;/b&gt;&lt;br/&gt;PostgreSQL&lt;br/&gt;quoteId, SK app ids,&lt;br/&gt;poll state, deadline" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="960" y="240" width="130" height="90" as="geometry" /></mxCell>
        <mxCell id="t425" value="&lt;b&gt;settlement-db&lt;/b&gt;&lt;br/&gt;PG" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontFamily=Arial;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="540" width="110" height="70" as="geometry" /></mxCell>
        <mxCell id="t426" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br/&gt;вЂў РҐСЂР°РЅРёР»РёС‰Рµ: &lt;b&gt;Р”Рђ&lt;/b&gt; (osago-db) вЂ” СЃРѕСЃС‚РѕСЏРЅРёРµ Р·Р°СЏРІРєРё/РѕРїСЂРѕСЃР° РѕР±С‰РµРµ РґР»СЏ РІСЃРµС… СЂРµРїР»РёРє.&lt;br/&gt;вЂў API Рє core-app: &lt;b&gt;Event Streaming&lt;/b&gt; (РЅРµ sync REST): consume &lt;i&gt;osago.quote.requested&lt;/i&gt;; publish &lt;i&gt;osago.offer.received&lt;/i&gt; / completed|timeout.&lt;br/&gt;вЂў РџРѕРґС…РѕРґ РєР°Рє Сѓ products: async РѕРїСЂРѕСЃ РЎРљ, push СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="t427" value="&lt;b&gt;Web в†” core-app&lt;/b&gt;&lt;br/&gt;1) &lt;b&gt;REST&lt;/b&gt; POST /api/osago/applications вЂ” СЃРѕР·РґР°С‚СЊ Р·Р°СЏРІРєСѓ в†’ 202 + id.&lt;br/&gt;2) &lt;b&gt;SSE&lt;/b&gt; GET /api/osago/applications/{id}/stream вЂ” РѕС„С„РµСЂС‹ РЅР° UI СЃСЂР°Р·Сѓ РїРѕ РјРµСЂРµ РїСЂРёС…РѕРґР° (в‰¤60СЃ).&lt;br/&gt;РћС„РѕСЂРјР»РµРЅРёРµ РїРѕР»РёСЃР° вЂ” REST (РІС‹Р±РѕСЂ РѕС„С„РµСЂР° / РѕРїР»Р°С‚Р°)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="170" height="160" as="geometry" /></mxCell>
        <mxCell id="t428" value="&lt;b&gt;Multi-instance&lt;/b&gt;&lt;br/&gt;Kafka consumer group + partition key=quoteId.&lt;br/&gt;РЎРѕСЃС‚РѕСЏРЅРёРµ РѕРїСЂРѕСЃР° вЂ” РІ osago-db (Р»СЋР±Р°СЏ СЂРµРїР»РёРєР° РїСЂРѕРґРѕР»Р¶Р°РµС‚).&lt;br/&gt;SSE: core-app РїРѕРґРїРёСЃС‹РІР°РµС‚СЃСЏ РЅР° Redis РєР°РЅР°Р» quoteId; РїРѕС‚СЂРµР±РёС‚РµР»СЊ Kafka РїСѓР±Р»РёРєСѓРµС‚ РѕС„С„РµСЂ РІ Redis в†’ РЅСѓР¶РЅС‹Р№ pod РїСѓС€РёС‚ РІ SSE." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="280" height="120" as="geometry" /></mxCell>
        <mxCell id="t429" value="&lt;b&gt;РќР°РіСЂСѓР·РєР° ~2500 concurrent&lt;/b&gt;&lt;br/&gt;HPA РЅР° core-app / osago-aggregator.&lt;br/&gt;RL РЅР° РІС…РѕРґРµ Рё РЅР° РёСЃС…РѕРґСЏС‰РёС… РІС‹Р·РѕРІР°С… Рє РєР°Р¶РґРѕР№ РЎРљ." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="450" width="180" height="100" as="geometry" /></mxCell>
