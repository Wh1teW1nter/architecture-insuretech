        <mxCell id="t416" value="&lt;b&gt;Event Streaming&lt;/b&gt;&lt;br/&gt;[Managed Apache Kafka]&lt;br/&gt;&lt;font style=&quot;font-size:9px&quot;&gt;products.* / tariffs.* / policies.issued&lt;br/&gt;&lt;b&gt;osago.quote.requested&lt;/b&gt;&lt;br/&gt;&lt;b&gt;osago.offer.received&lt;/b&gt;&lt;br/&gt;&lt;b&gt;osago.quote.completed|timeout&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#000000;strokeColor=#C77D0A;fontFamily=Arial;fontSize=10;align=center;verticalAlign=top;spacingTop=4;fontStyle=1" vertex="1" parent="1"><mxGeometry x="460" y="240" width="210" height="130" as="geometry" /></mxCell>
